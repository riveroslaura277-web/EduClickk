@model List<EduClick.Models.Usuario>
@{
    Layout = "~/Views/Shared/_LayoutRector.cshtml";
}

<section id="dashboard-usuarios">
    <h2>Lista de Usuarios</h2>
    <table class="tabla-usuarios">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.IdUsuario</td>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Correo</td>
                    <td>@usuario.Rol?.NombreRol</td>
                </tr>
            }
        </tbody>
    </table>
</section>
