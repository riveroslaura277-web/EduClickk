@model EduClick.Models.Usuarios
@{
    Layout = null;
}

<h2>Editar Usuario</h2>

<form asp-action="Editar" method="post">

    <!-- IMPORTANTE -->
    <input type="hidden" asp-for="Id" />

    <div>
        <label>Nombres:</label>
        <input asp-for="Nombres" />
    </div>

    <div>
        <label>Apellidos:</label>
        <input asp-for="Apellidos" />
    </div>

    <div>
        <label>Correo:</label>
        <input asp-for="Correo" type="email" />
    </div>

    <div>
        <label>Contraseña:</label>
        <input asp-for="Contrasena" type="password" />
    </div>

    <div>
        <label>Rol:</label>
        <select asp-for="Rol">
            <option value="Estudiante">Estudiante</option>
            <option value="Acudiente">Acudiente</option>
            <option value="Docente">Docente</option>
            <option value="Rector">Rector</option>
        </select>
    </div>

    <button type="submit" class="btn-crear">
        Guardar Cambios
    </button>

    <a asp-action="Listar" class="btn-crear">
        Volver
    </a>

</form>