@{
    ViewData["Title"] = "EduClick";
}

<!-- FONT AWESOME -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<section class="main-container">

    <!-- =========================
         NAVBAR
    ========================== -->
    <header class="navbar">

        <!-- LOGO -->
        <div class="logo">

            <img src="~/imagenes/icono.png" alt="EduClick Logo" />

            <div class="logo-text">
                <h2>EduClick</h2>
                <p>Aprender es la aventura más emocionante</p>
            </div>

        </div>

        <!-- MENU -->
        <nav class="menu">

            <a href="#" class="active inicio">
                <i class="fa-solid fa-house"></i>
                <span>Inicio</span>
            </a>

            <a href="#" class="actividades">
                <i class="fa-solid fa-book-open"></i>
                <span>Actividades</span>
            </a>

            <a href="#" class="evidencias">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <span>Evidencias</span>
            </a>

            <a href="#" class="recursos">
                <i class="fa-solid fa-folder-open"></i>
                <span>Recursos</span>
            </a>

        </nav>

        <!-- BOTONES -->
        <div class="actions">

            <a asp-controller="Usuario"
               asp-action="Inicio"
               class="btn login">

                <i class="fa-solid fa-user"></i>
                Iniciar sesión
            </a>
            

            <a asp-controller="Registro"
               asp-action="Index"
               class="btn login">


            <a asp-controller="Registro"
               asp-action="Index"
               class="btn login">

                <i class="fa-solid fa-user"></i>
                Registrarse
            </a>

        </div>

    </header>

    <!-- =========================
         HERO
    ========================== -->
    <section class="hero">

        <div class="hero-content">

            <!-- TEXTO -->
            <div class="hero-text">

                <h1>
                    Explora, aprende <br />
                    y <span>diviértete</span>
                </h1>

                <p>
                    Descubre actividades interactivas,
                    recursos educativos y juegos
                    para aprender cada día.
                </p>

                <a href="#" class="start-btn">
                    ¡Comenzar aventura!
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>

        </div>

    </section>
