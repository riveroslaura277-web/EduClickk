@{
    ViewData["Title"] = "EduClick";
}

<!-- FONT AWESOME -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<video class="video-principal" autoplay muted loop>
    <source src="@Url.Content("~/imagenes/video_principal.mp4")" type="video/mp4">
    Tu navegador no soporta video.
</video>

<section class="main-container">


    <header class="navbar">
        <h2>EduClick</h2>
        <p>Aprender es la aventura más emocionante</p>

       
        <nav class="menu">

            <a asp-controller="Home" asp-action="Index" class="active">
                <i class="fa-solid fa-house"></i>
                <span>Inicio</span>
            </a>
            <a href="#">
                <i class="fa-solid fa-book-open"></i>
                <span>Actividades</span>
            </a>
            <a href="#">
                <i class="fa-solid fa-box"></i>
                <span>Recursos</span>
            </a>
            <a asp-controller="Alumnos" asp-action="Index">
                <i class="fa-solid fa-phone"></i>
                <span>Alumnos</span>
            </a>
        </nav>

        <!-- BOTONES -->
        <div class="actions">

            <div class="menu-login">

                <button class="btn login">
                    <i class="fa-solid fa-user"></i>
                    Iniciar sesión
                    <i class="fa-solid fa-caret-down"></i>
                </button>


                <div class="dropdown">
                    <a asp-controller="Usuario" asp-action="IniciarConGoogle"
                       asp-route-rol="Docente">Docente</a>
                    <a asp-controller="Usuario" asp-action="IniciarConGoogle"
                       asp-route-rol="Estudiante">Estudiante</a>
                    <a asp-controller="Usuario" asp-action="IniciarConGoogle"
                       asp-route-rol="Acudiente">Acudiente</a>
                    <a asp-controller="Usuario" asp-action="IniciarConGoogle"
                       asp-route-rol="Rector">Rector</a>
                    <a asp-controller="Usuario" asp-action="IniciarConGoogle"
                       asp-route-rol="Administrador">Administrador</a>

                    <hr style="border-color: rgba(255,255,255,0.2); margin: 4px 0;">

                    <a href="https://accounts.google.com/signin/recovery"
                       target="_blank"
                       style="font-size: 0.8rem; opacity: 0.8;">
                        <i class="fa-solid fa-key"></i>
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

            </div>


            <a asp-controller="Registro" asp-action="Index" class="btn login">
                <i class="fa-solid fa-user-plus"></i>
                Registrarse
            </a>

        </div>

    </header>

  
         
    
    <section class="hero">

        <div class="hero-text">

            <h1>
                Explora, aprende <br />
                y <span>diviértete</span>
            </h1>

            <p>
                Descubre actividades interactivas,
                recursos educativos y juegos para aprender cada día.
            </p>

            <a href="#" class="start-btn">
                ¡Comenzar aventura!
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

        <div class="card challenge">
            <img src="~/imagenes/iconoreto.png" alt="Retos">
            <h3>Retos</h3>
            <p>Pon a prueba lo que sabes y gana medallas.</p>
            <a href="#" class="btn-card">Explorar →</a>
        </div>
    </section>

</section>
