@{
    ViewData["Title"] = "Actividades Matemáticas";
}

<link rel="stylesheet" href="~/css/matem.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<!-- TOPBAR -->
<header class="topbar">

    <div class="logo">
        <img src="~/Imagenes/icono.png" alt="EduClick">

        <div>
            <h1>EduClick</h1>
            <p>Aprender es la aventura más emocionante</p>
        </div>
    </div>

    <div class="saludo">
        <h2>¡Hola, Sofía! 👋</h2>
        <p>Hoy es un gran día para aprender cosas nuevas 🌿</p>
    </div>

    <div class="usuario">

        <div class="puntos">
            ⭐
            <div>
                <strong>1200</strong>
                <span>Puntos</span>
            </div>
        </div>

        <div class="notificacion">
            🔔
        </div>

        <div class="perfil">
            <img src="~/Imagenesmate/icono avatar.png" alt="Perfil">

            <div>
                <strong>Sofía</strong>
                <span>Estudiante</span>
            </div>
        </div>

    </div>

</header>

<!-- BANNER -->
<section class="banner-mate">

    <div class="icono-mate">
        <img src="~/Imagenesmate/iconomate (2).png" alt="Números y Conteo">
    </div>

    <div class="info-banner">

        <div class="ruta">
            <span>Actividades Matemáticas</span>
            <span>></span>
            <span>Grado Primero</span>
        </div>

        <h1>Grado Primero</h1>

        <p>
            Explora los temas y diviértete aprendiendo.
        </p>

    </div>

</section>

<div class="pagina">

    <!-- MENÚ LATERAL -->
    <aside class="sidebar">

        <div class="menu">

            <a href="#">
                <i class="fa-solid fa-house"></i> Inicio
            </a>

            <a href="#">
                <i class="fa-solid fa-book"></i> Materias
            </a>

            <a href="#" class="active">
                <i class="fa-solid fa-clipboard-list"></i> Actividades
            </a>

            <a href="#">
                <i class="fa-solid fa-folder"></i> Recursos
            </a>

            <a href="#">
                <i class="fa-solid fa-trophy"></i> Logros
            </a>

            <a href="#">
                <i class="fa-solid fa-chart-line"></i> Mi progreso
            </a>

            <a href="#">
                <i class="fa-solid fa-gear"></i> Ajustes
            </a>

            <a href="#">
                <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>

        </div>

        <div class="mascota">

            <img src="~/Imagenesmate/tigre.png" alt="Tigre">

            <div class="mensaje">
                <h3>¡Sigue practicando!</h3>
                <p>Cada actividad te acerca más a tus sueños.</p>
            </div>

        </div>

    </aside>

    <!-- CONTENIDO -->
    <main class="contenido">

        <div class="grid-actividades">

            <div class="card">
                <span class="numero">1</span>

                <img src="~/IMA MATE/conteo numeros.png" alt="Contar números">

                <h3>Contar Números</h3>

                <a href="@Url.Action("Index","ActiMate")" class="btn-explorar">
                    Explorar →
                </a>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/orden numeros.png" alt="">
                <h3>Comparación y Orden</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/sumas.png" alt="">
                <h3>Sumas</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/restas.png" alt="">
                <h3>Restas</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/decenas.png" alt="">
                <h3>Decenas y Unidades</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/resolucion.png" alt="">
                <h3>Resolución de Problemas</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/figuras.png" alt="">
                <h3>Figuras Geométricas</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/ubicacion.png" alt="">
                <h3>Ubicación Espacial</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/medidas.png" alt="">
                <h3>Medidas</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/tiempo.png" alt="">
                <h3>Tiempo y Calendario</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/patrones.png" alt="">
                <h3>Patrones y Secuencias</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/recolecion.png" alt="">
                <h3>Recolección de Datos</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/grafica.png" alt="">
                <h3>Gráficas Simples</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/retos.png" alt="">
                <h3>Retos Matemáticos</h3>
            </div>

            <div class="card">
                <img src="~/Imagenesmate/juegos.png" alt="">
                <h3>Juegos Matemáticos</h3>
            </div>

        </div>

    </main>

</div>