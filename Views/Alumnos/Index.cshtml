@{
    ViewData["Title"] = "Dashboard Estudiante";
    Layout = null;
}

<link rel="stylesheet" href="~/css/estudiante-dashboard.css" />
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="dashboard-container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <img src="~/Estudiantes/Logo.png" alt="Logo">
        </div>

        <nav>

            <a href="#" class="activo">
                <i class="fa-solid fa-house"></i>
                Inicio
            </a>

            <a href="#">
                <i class="fa-solid fa-book"></i>
                Mis Materias
            </a>

            <a href="#">
                <i class="fa-solid fa-clipboard-list"></i>
                Tareas
            </a>

            <a href="#">
                <i class="fa-solid fa-list-check"></i>
                Actividades
            </a>

            <a href="#">
                <i class="fa-solid fa-chart-column"></i>
                Evaluaciones
            </a>

            <a href="#">
                <i class="fa-solid fa-gamepad"></i>
                Juegos
            </a>

            <a href="#">
                <i class="fa-solid fa-circle-play"></i>
                Videos
            </a>

            <a href="#">
                <i class="fa-solid fa-robot"></i>
                Chat IA
            </a>

            <a href="#">
                <i class="fa-solid fa-trophy"></i>
                Retos
            </a>

            <a href="#">
                <i class="fa-solid fa-medal"></i>
                Logros
            </a>

            <a href="#">
                <i class="fa-solid fa-calendar"></i>
                Calendario
            </a>

            <a href="#">
                <i class="fa-solid fa-folder"></i>
                Recursos
            </a>

            <a href="#">
                <i class="fa-solid fa-user"></i>
                Mi Perfil
            </a>

        </nav>

        <img class="buho"
             src="~/Estudiantes/buho.png"
             alt="">

    </aside>


    <!-- CENTRO -->

    <main class="contenido">

        <!-- HEADER -->

        <header class="topbar">

            <div class="saludo">

                <h2>¡Hola, Sofia! 👋</h2>

                <p>
                    Cada pequeño paso te acerca a grandes logros.
                    ¡Sigue aprendiendo!
                </p>

                <div class="points">
                    ⭐ 1200
                    <small>Puntos</small>
                </div>


            <div class="usuario">

                <div class="puntos">

                    <img src="~/Estudiantes/Puntos.png">

                    <span>1200</span>

                </div>


                <img class="avatar"
                     src="~/Estudiantes/icono avatar.png">

                    <div>

                        <h4>Sofía</h4>
                        <p>Estudiante</p>

                    </div>

                </div>

            </div>

        </header>


        <!-- BANNER -->

        <section class="banner">

            <div class="texto-banner">

                <h1>
                    Aprender es descubrir
                    que puedes lograr
                    cosas increíbles
                </h1>

                <button>
                    ¡Comenzar aventura!
                </button>

            </div>

            <img src="~/Estudiantes/icono banner.png">

        </section>
        <section class="materias">

            <h3>🌿 Mis materias</h3>

            <div class="materias-grid">

                <div class="materia">
                    <img src="~/Estudiantes/calculadora.png">
                    <h4>Matemáticas</h4>
                    <progress value="75" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/mundo.png">
                    <h4>Ciencias</h4>
                    <progress value="80" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/libro.png">
                    <h4>Lengua</h4>
                    <progress value="65" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/ingles.png">
                    <h4>Inglés</h4>
                    <progress value="70" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/sociales.png">
                    <h4>Sociales</h4>
                    <progress value="60" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/tecnologia.png">
                    <h4>Tecnología</h4>
                    <progress value="85" max="100"></progress>
                </div>

                            <h4>Tecnología</h4>

                            <p>Explora, crea e innova con la tecnología.</p>

                            <div class="btn-subject">
                                Explorar →
                            </div>

                        </a>

       

        <!-- ABAJO -->

        <section class="bottom">

            <div class="actividad">

                <h3>Actividad reciente</h3>

                <div class="item">
                    Quiz completado de matemáticas +20 pts
                </div>

                <div class="item">
                    Video de ciencias visto +15 pts
                </div>

                <div class="item">
                    Juego completado +25 pts
                </div>

            </div>


            <div class="sugerencias">

                <h3>Sugerencias para ti</h3>

                <div class="item">
                    Practica sumas y restas
                </div>

                <div class="item">
                    Lee un cuento corto
                </div>

                <div class="item">
                    Explora sistema solar
                </div>

            </div>

        </section>

    </main>


    <!-- DERECHA -->

    <aside class="panel-derecho">


        <div class="progreso">

            <h3>Mi progreso</h3>

            <div class="porcentaje">
                72%
            </div>

        </div>



        <div class="reto">

            <h3>Reto del día</h3>

            <img src="~/Estudiantes/icono tigre.png">

            <button>
                Aceptar reto
            </button>

                </div>



        <div class="tareas">

            <h3>Próximas tareas</h3>

            <p>Mapa conceptual</p>

            <p>Ejercicios fracciones</p>

            <p>Resumen historia</p>

            <p>Energías renovables</p>

        </div>

    </aside>

        </div>

    </main>

</div>