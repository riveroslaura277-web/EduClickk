@{
    ViewData["Title"] = "Panel Estudiante";
}

<link rel="stylesheet" href="~/css/estudiante-dashboard.css" />
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="dashboard">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">
            <img src="~/Estudiantes/Logo.png">
        </div>

        <nav>

            <a class="activo"><i class="fa-solid fa-house"></i> Inicio</a>
            <a><i class="fa-solid fa-book"></i> Mis Materias</a>
            <a><i class="fa-solid fa-clipboard-check"></i> Tareas</a>
            <a><i class="fa-solid fa-list-check"></i> Actividades</a>
            <a><i class="fa-solid fa-chart-column"></i> Evaluaciones</a>
            <a><i class="fa-solid fa-gamepad"></i> Juegos</a>
            <a><i class="fa-solid fa-circle-play"></i> Videos</a>
            <a><i class="fa-solid fa-robot"></i> Chat IA</a>
            <a><i class="fa-solid fa-trophy"></i> Retos</a>
            <a><i class="fa-solid fa-medal"></i> Logros</a>
            <a><i class="fa-solid fa-calendar"></i> Calendario</a>
            <a><i class="fa-solid fa-folder"></i> Recursos</a>
            <a><i class="fa-solid fa-user"></i> Mi Perfil</a>

        </nav>

        <img class="buho" src="~/Estudiantes/buhuo.png">

    </aside>


    <!-- CONTENIDO -->

    <main class="contenido">

        <!-- HEADER -->

        <header class="topbar">

            <div class="saludo">
                <h2>¡Hola, Sofia! 👋</h2>
                <p>Cada pequeño paso te acerca a grandes logros.</p>
            </div>

            <div class="usuario">

                <div class="puntos">
                    <img src="~/Estudiantes/Puntos.png">
                    <span>1200 Puntos</span>
                </div>

                <img class="avatar"
                     src="~/Estudiantes/icono avatar.png">

            </div>

        </header>


        <!-- BANNER -->

        <section class="banner">

            <div class="texto-banner">

                <h1>
                    Aprender es descubrir <br>
                    que puedes lograr <br>
                    cosas increíbles
                </h1>

                <button>¡Comenzar aventura!</button>

            </div>

            <img src="~/Estudiantes/pagina niños.png">

        </section>


        <!-- MATERIAS -->

        <section class="materias">

            <h3>🌿 Mis materias</h3>

            <div class="materias-grid">

                <div class="materia">
                    <img src="~/Estudiantes/calculadora.png">
                    <h4>Matemáticas</h4>
                    <progress value="75" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/mundo.png">
                    <h4>Ciencias</h4>
                    <progress value="80" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/libro.png">
                    <h4>Lengua</h4>
                    <progress value="65" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/ingles.png">
                    <h4>Inglés</h4>
                    <progress value="70" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/sociales.png">
                    <h4>Sociales</h4>
                    <progress value="60" max="100"></progress>
                </div>

                <div class="materia">
                    <img src="~/Estudiantes/tecnologia.png">
                    <h4>Tecnología</h4>
                    <progress value="85" max="100"></progress>
                </div>

            </div>

        </section>


        <!-- DOS CAJAS -->

        <section class="bottom">

            <div class="actividad">

                <h3>Actividad reciente</h3>

                <div class="item">Quiz completado +20 pts</div>
                <div class="item">Video visto +15 pts</div>
                <div class="item">Juego completado +25 pts</div>

            </div>


            <div class="sugerencias">

                <h3>Sugerencias para ti</h3>

                <div class="item">Practica sumas</div>
                <div class="item">Lee un cuento</div>
                <div class="item">Explora sistema solar</div>

            </div>

        </section>

    </main>


    <!-- DERECHA -->

    <aside class="panel-derecho">

        <div class="progreso">

            <h3>Mi progreso</h3>

            <div class="porcentaje">72%</div>

        </div>


        <div class="reto">

            <h3>Reto del día</h3>

            <img src="~/Estudiantes/icono tigre.png">

            <button>Aceptar reto</button>

        </div>


        <div class="tareas">

            <h3>Próximas tareas</h3>

            <p>Mapa conceptual</p>
            <p>Ejercicios fracciones</p>
            <p>Resumen historia</p>
            <p>Presentación energías</p>

        </div>

    </aside>

</div>