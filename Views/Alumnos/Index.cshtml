@{
    ViewData["Title"] = "Panel Estudiante";
}

<link rel="stylesheet" href="~/css/estudiante-dashboard.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="dashboard">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo-card">
            <img src="~/imagenes/logo.png" alt="">
            <h1>Edu<span>Click</span></h1>
            <p>Aprender hoy, transformar mañana</p>
        </div>

        <nav class="menu">

            <a href="#" class="active">
                <i class="fas fa-home"></i>
                Inicio
            </a>

            <a href="#">
                <i class="fas fa-book"></i>
                Mis Materias
            </a>

            <a href="#">
                <i class="fas fa-clipboard-list"></i>
                Tareas
                <span class="badge">4</span>
            </a>

            <a href="#">
                <i class="fas fa-list-check"></i>
                Actividades
            </a>

            <a href="#">
                <i class="fas fa-chart-column"></i>
                Evaluaciones
            </a>

            <a href="#">
                <i class="fas fa-gamepad"></i>
                Juegos
            </a>

            <a href="#">
                <i class="fas fa-circle-play"></i>
                Videos
            </a>

            <a href="#">
                <i class="fas fa-robot"></i>
                Chat IA
            </a>

            <a href="#">
                <i class="fas fa-trophy"></i>
                Retos
            </a>

            <a href="#">
                <i class="fas fa-medal"></i>
                Logros
            </a>

            <a href="#">
                <i class="fas fa-calendar"></i>
                Calendario
            </a>

            <a href="#">
                <i class="fas fa-folder"></i>
                Recursos
            </a>

            <a href="#">
                <i class="fas fa-user"></i>
                Mi Perfil
            </a>

        </nav>

        <div class="owl">
            <img src="~/Estudiantes/buhuo.png" alt="">
        </div>

    </aside>

    <!-- MAIN -->
    <main class="content">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="welcome">
                <h2>¡Hola, Sofia! 👋</h2>
                <p>Cada pequeño paso te acerca a grandes logros.</p>
            </div>

            <div class="top-actions">

                <div class="points">
                    ⭐ 1200
                    <small>Puntos</small>
                </div>

                <div class="notification">
                    <i class="fas fa-bell"></i>
                    <span>3</span>
                </div>

                <div class="profile">
                    <img src="~/Estudiantes/icono avatar.png">
                    <div>
                        <h4>Sofia</h4>
                        <small>Estudiante</small>
                    </div>
                </div>

            </div>

        </header>

        <div class="main-grid">

            <!-- IZQUIERDA -->
            <section class="left-column">

                <!-- HERO -->
                <div class="hero">

                    <div class="hero-text">

                        <h1>
                            Aprender es descubrir
                            que puedes lograr
                            cosas <span>increíbles.</span>
                        </h1>

                        <p>
                            Explora, pregunta, practica y
                            diviértete mientras aprendes.
                        </p>

                        <button>
                            ¡Comenzar aventura!
                        </button>

                    </div>

                </div>
                <!-- MATERIAS -->
                <div class="card-section">

                    <div class="section-title">
                        <h3>📚 Mis Materias</h3>
                    </div>

                    <div class="subjects">

                        <!-- Matemáticas -->
                        <a asp-controller="Materias"
                           asp-action="Matematicas"
                           class="subject math">

                            <div class="icon">
                                <img src="~/Estudiantes/calculadora.png" alt="Matemáticas">
                            </div>

                            <h4>Matemáticas</h4>

                            <p>Aprende números, operaciones y problemas.</p>

                            <div class="btn-subject">
                                Explorar →
                            </div>

                        </a>

                        <!-- Lectura -->
                        <a asp-controller="Materias"
                           asp-action="Lectura"
                           class="subject language">

                            <div class="icon">
                                <img src="~/Estudiantes/libro .png" alt="Lectura">
                            </div>

                            <h4>Lectura</h4>

                            <p>Mejora tu comprensión leyendo cuentos y textos.</p>

                            <div class="btn-subject">
                                Explorar →
                            </div>

                        </a>

                        <!-- Ciencias -->
                        <a asp-controller="Materias"
                           asp-action="Ciencias"
                           class="subject science">

                            <div class="icon">
                                <img src="~/Estudiantes/mundo .png" alt="Ciencias">
                            </div>

                            <h4>Ciencias</h4>

                            <p>Descubre el mundo que te rodea.</p>

                            <div class="btn-subject">
                                Explorar →
                            </div>

                        </a>

                        <!-- Inglés -->
                        <a asp-controller="Materias"
                           asp-action="Ingles"
                           class="subject english">

                            <div class="icon">
                                <img src="~/Estudiantes/ingles.png" alt="Inglés">
                            </div>

                            <h4>Inglés</h4>

                            <p>Aprende nuevas palabras y expresiones.</p>

                            <div class="btn-subject">
                                Explorar →
                            </div>

                        </a>

                        <!-- Sociales -->
                        <a asp-controller="Materias"
                           asp-action="Sociales"
                           class="subject social">

                            <div class="icon">
                                <img src="~/Estudiantes/sociales.png" alt="Sociales">
                            </div>

                            <h4>Sociales</h4>

                            <p>Conoce la historia y la cultura de nuestro mundo.</p>

                            <div class="btn-subject">
                                Explorar →
                            </div>

                        </a>

                        <!-- Tecnología -->
                        <a asp-controller="Materias"
                           asp-action="Tecnologia"
                           class="subject tech">

                            <div class="icon">
                                <img src="~/Estudiantes/tecnologia.png" alt="Tecnología">
                            </div>

                            <h4>Tecnología</h4>

                            <p>Explora, crea e innova con la tecnología.</p>

                            <div class="btn-subject">
                                Explorar →
                            </div>

                        </a>

                    </div>

                </div>
                                                                  


                <!-- ACTIVIDAD Y SUGERENCIAS -->
                <div class="bottom-grid">

                    <div class="activities">

                        <div class="section-title">
                            <h3>🍃 Actividad reciente</h3>
                        </div>

                        <div class="activity">
                            <span>📋</span>
                            <p>Completaste el quiz "División de fracciones"</p>
                            <strong>+20 pts</strong>
                        </div>

                        <div class="activity">
                            <span>▶️</span>
                            <p>Viste el video "El ciclo del agua"</p>
                            <strong>+15 pts</strong>
                        </div>

                        <div class="activity">
                            <span>💬</span>
                            <p>Participaste en el foro</p>
                            <strong>+10 pts</strong>
                        </div>

                    </div>

                    <div class="suggestions">

                        <div class="section-title">
                            <h3>💡 Sugerencias para ti</h3>
                        </div>

                        <div class="suggestion">
                            Practica sumas y restas
                            <i class="fas fa-arrow-right"></i>
                        </div>

                        <div class="suggestion">
                            Lee "El Principito"
                            <i class="fas fa-arrow-right"></i>
                        </div>

                        <div class="suggestion">
                            Explora el sistema solar
                            <i class="fas fa-arrow-right"></i>
                        </div>

                    </div>

                </div>

            </section>

            <!-- DERECHA -->
            <aside class="right-column">

                <div class="progress-card">

                    <h3>Mi progreso</h3>

                    <div class="circle">
                        72%
                    </div>

                    <p>¡Vas excelente!</p>

                    <div class="stats">

                        <div>
                            ⭐
                            <h4>1200</h4>
                            <small>Puntos</small>
                        </div>

                        <div>
                            🔥
                            <h4>18</h4>
                            <small>Racha</small>
                        </div>

                        <div>
                            🏅
                            <h4>7</h4>
                            <small>Nivel</small>
                        </div>

                    </div>

                </div>

                <div class="challenge">

                    <h3>Reto del día 🚀</h3>

                    <p>
                        Resuelve 10 preguntas de matemáticas.
                    </p>

                    <button>
                        ¡Aceptar reto!
                    </button>

                </div>

                <div class="tasks">

                    <div class="section-title">
                        <h3>Próximas tareas</h3>
                    </div>

                    <div class="task">
                        🌿 Mapa conceptual
                        <span>Mañana</span>
                    </div>

                    <div class="task">
                        🧮 Ejercicios de fracciones
                        <span>2 días</span>
                    </div>

                    <div class="task">
                        🏛️ Revolución Francesa
                        <span>3 días</span>
                    </div>

                    <div class="task">
                        💻 Energías renovables
                        <span>5 días</span>
                    </div>

                </div>

            </aside>

        </div>

    </main>

</div>