@{
    ViewData["Title"] = "EduBot";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EduBot</title>

    <link rel="stylesheet" href="~/css/Chat.css>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>

    <div class="dashboard">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="logo">
                <img src="~/CHAT/Logo.png" alt="">
            </div>

            <nav>
                <a href="#"><i class="fa-solid fa-house"></i> Inicio</a>
                <a href="#"><i class="fa-solid fa-book"></i> Materias</a>
                <a href="#"><i class="fa-solid fa-list-check"></i> Actividades</a>
                <a href="#"><i class="fa-solid fa-folder"></i> Recursos</a>
                <a href="#"><i class="fa-solid fa-video"></i> Videos</a>
                <a href="#"><i class="fa-solid fa-trophy"></i> Logros</a>
                <a href="#"><i class="fa-solid fa-chart-column"></i> Mi progreso</a>
                <a href="#"><i class="fa-solid fa-gamepad"></i> Juegos</a>

                <a href="#" class="active">
                    <i class="fa-solid fa-robot"></i> ChatBot
                </a>

                <a href="#"><i class="fa-solid fa-gear"></i> Ajustes</a>
                <a href="#"><i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión</a>
            </nav>

        </aside>

        <!-- CONTENIDO -->
        <main class="main">

            <!-- TOPBAR -->
            <div class="topbar">

                <div class="saludo">
                    <h2>¡Hola, Sofía! 👋</h2>
                    <p>Estoy aquí para ayudarte a aprender y resolver tus dudas</p>
                </div>

                <div class="top-right">

                    <div class="puntos">
                        <img src="~/CHAT/puntos.png">
                        <div>
                            <h3>1200</h3>
                            <span>Puntos</span>
                        </div>
                    </div>

                    <div class="notificacion">
                        <i class="fa-regular fa-bell"></i>
                        <span>3</span>
                    </div>

                    <div class="perfil">
                        <img src="~/CHAT/avatar.png">
                        <div>
                            <h4>Sofía</h4>
                            <span>Estudiante</span>
                        </div>
                    </div>

                </div>

            </div>

            <!-- CHAT -->
            <div class="chat-card">

                <div class="chat-header">

                    <div class="chat-title">
                        <img src="~/CHAT/icono robot.png">
                        <div>
                            <h2>EduBot</h2>
                            <span>Tu asistente de aprendizaje inteligente</span>
                        </div>
                    </div>

                    <div class="estado">
                        ● En línea
                    </div>

                </div>

                <div class="chat-body">

                    <div class="mensaje bot">
                        <img src="~/CHAT/icono robot.png">
                        <div class="burbuja">
                            <strong>¡Hola, Sofía! 😊</strong>
                            <p>Soy EduBot, tu asistente inteligente.</p>
                            <p>¿En qué puedo ayudarte hoy?</p>
                        </div>
                    </div>

                    <div class="mensaje usuario">

                        <div class="burbuja user">
                            Hola EduBot 👋<br>
                            ¿Puedes explicarme qué es el sistema solar?
                        </div>

                        <img src="~/CHAT/icono avatar.png">
                    </div>

                    <div class="mensaje bot">
                        <img src="~/CHAT/robot.png">

                        <div class="respuesta">

                            <div class="burbuja">
                                <strong>¡Claro que sí! 🌎✨</strong>

                                <p>
                                    El sistema solar es un conjunto de planetas,
                                    lunas, asteroides y otros cuerpos celestes que
                                    giran alrededor del Sol.
                                </p>
                            </div>

                            <div class="contenido-solar">

                                <img src="~/CHAT/imagen.png">

                                <div class="info">
                                    <h4>Nuestro sistema solar</h4>

                                    <ul>
                                        <li>8 planetas</li>
                                        <li>El Sol es una estrella</li>
                                        <li>Hay lunas y asteroides</li>
                                        <li>Todos orbitan al Sol</li>
                                    </ul>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>

                <div class="preguntas">

                    <button>¿Cuántos planetas hay?</button>
                    <button>¿Qué es una estrella?</button>
                    <button>¿Qué es la gravedad?</button>

                </div>

                <div class="input-chat">

                    <input type="text"
                           placeholder="Escribe tu pregunta aquí...">

                    <button>
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>

                </div>

            </div>

        </main>

        <!-- PANEL DERECHO -->
        <aside class="right-panel">

            <div class="panel">

                <h3>⚡ Acciones rápidas</h3>

                <button>📖 Explicar un tema</button>
                <button>🧩 Resolver un problema</button>
                <button>💡 Darme un consejo</button>
                <button>🎮 Recomendar actividad</button>

            </div>

            <div class="panel">

                <h3>⭐ Temas populares</h3>

                <ul>
                    <li>🌍 El sistema solar</li>
                    <li>🦖 Los dinosaurios</li>
                    <li>📊 Fracciones</li>
                    <li>🌋 Los volcanes</li>
                    <li>❤️ El cuerpo humano</li>
                </ul>

            </div>

        </aside>

    </div>

</body>
</html>