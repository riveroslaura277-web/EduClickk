@{
    ViewData["Title"] = "Materias";
}

<link rel="stylesheet" href="~/css/materias.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<!-- TOPBAR -->
<header class="topbar">

    <div class="logo">
        <img src="~/Imagenes/icono.png" alt="EduClick">

        <div>
            <h1>EduClick</h1>
            <p>Aprender es la aventura más emocionante</p>
        </div>
    </div>

    <div class="saludo">
        <h2>¡Hola, Sofía! 👋</h2>
        <p>Hoy es un gran día para aprender cosas nuevas 🌿</p>
    </div>

    <div class="usuario">

        <div class="puntos">
            ⭐
            <div>
                <strong>1200</strong>
                <span>Puntos</span>
            </div>
        </div>

        <div class="notificacion">
            🔔
        </div>

        <div class="perfil">
            <img src="~/Imagenesmate/icono avatar.png" alt="Perfil">

            <div>
                <strong>Sofía</strong>
                <span>Estudiante</span>
            </div>
        </div>

    </div>

</header>

<!-- BANNER -->
<div class="banner-mate">

    <div class="icono-mate">
        <img src="~/Imagenes_Materias/Libro.png" alt="Materias">
    </div>

    <div class="info-banner">

        <div class="ruta">
            <span>Materias</span>
            <span>></span>
        </div>

        <h1>Materias</h1>

        <p>
            Descubre los números, cuenta objetos y entiende cómo
            funcionan en tu día a día.
        </p>

    </div>

</div>

<!-- CONTENIDO PRINCIPAL -->
<div class="pagina">

    <!-- MENÚ LATERAL -->
    <aside class="sidebar">

        <div class="menu">

            <a href="#">
                <i class="fa-solid fa-house"></i> Inicio
            </a>

            <a href="#" class="active">
                <i class="fa-solid fa-book"></i> Materias
            </a>

            <a href="#">
                <i class="fa-solid fa-clipboard-list"></i> Actividades
            </a>

            <a href="#">
                <i class="fa-solid fa-folder"></i> Recursos
            </a>

            <a href="#">
                <i class="fa-solid fa-trophy"></i> Logros
            </a>

            <a href="#">
                <i class="fa-solid fa-chart-line"></i> Mi progreso
            </a>

            <a href="#">
                <i class="fa-solid fa-gear"></i> Ajustes
            </a>

            <a href="#">
                <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>

        </div>

        <div class="mascota">

            <img src="~/Imagenesmate/tigre.png" alt="Tigre">

            <div class="mensaje">
                <h3>¡Sigue practicando!</h3>
                <p>Cada actividad te acerca más a tus sueños.</p>
            </div>

        </div>

    </aside>

    <!-- CONTENIDO -->
    <main class="contenido-principal">

        <section class="materias">

            <div class="grid">

                <!-- MATEMÁTICAS -->
                <div class="card matematica">

                    <img src="~/Imagenes_Materias/Matematicas.png" alt="Matemáticas">

                    <h3>Matemáticas</h3>

                    <p>
                        Aprende números, sumas, restas y mucho más.
                    </p>

                    <a href="@Url.Action("Index","Matematicas")"
                       class="btn-explorar">
                        Explorar →
                    </a>

                </div>

                <!-- ESPAÑOL -->
                <div class="card lenguaje">

                    <img src="~/Imagenes_Materias/Español.png" alt="Lenguaje">

                    <h3>Lenguaje</h3>

                    <p>
                        Mejora tu lectura, escritura y comprensión.
                    </p>

                    <button class="btn-explorar">
                        Explorar →
                    </button>

                </div>

                <!-- SOCIALES -->
                <div class="card sociales">

                    <img src="~/Imagenes_Materias/Sociales.png" alt="Sociales">

                    <h3>Ciencias Sociales</h3>

                    <p>
                        Conoce tu historia, tu país y el mundo.
                    </p>

                    <button class="btn-explorar">
                        Explorar →
                    </button>

                </div>

                <!-- NATURALES -->
                <div class="card naturales">

                    <img src="~/Imagenes_Materias/Naturales.png" alt="Naturales">

                    <h3>Ciencias Naturales</h3>

                    <p>
                        Descubre los seres vivos y la naturaleza.
                    </p>

                    <button class="btn-explorar">
                        Explorar →
                    </button>

                </div>

                <!-- TECNOLOGÍA -->
                <div class="card tecnologia">

                    <img src="~/Imagenes_Materias/tecnologia.png" alt="Tecnología">

                    <h3>Tecnología</h3>

                    <p>
                        Explora la tecnología y el mundo digital.
                    </p>

                    <button class="btn-explorar">
                        Explorar →
                    </button>

                </div>

                <!-- INGLÉS -->
                <div class="card ingles">

                    <img src="~/Imagenes_Materias/Ingles.png" alt="Inglés">

                    <h3>Inglés</h3>

                    <p>
                        Aprende inglés de forma divertida.
                    </p>

                    <button class="btn-explorar">
                        Explorar →
                    </button>

                </div>

            </div>

        </section>

    </main>

</div>