@{
    ViewData["Title"] = "Actividades";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EduClick - Actividades</title>

    <link rel="stylesheet" href="~/css/actividades.css?v=123" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>

    <!-- HEADER -->
    <header class="topbar">

        <div class="logo">
            <img src="~/Imagenes/icono.png" alt="Logo">
            <div>
                <h2>EduClick</h2>
                <span>Aprender es la aventura más emocionante</span>
            </div>
        </div>

        <nav class="menu">
            <a href="#"><i class="fas fa-home"></i> Inicio</a>
            <a class="active" href="#"><i class="fas fa-book-open"></i> Actividades</a>
            <a href="#"><i class="fas fa-box"></i> Recursos</a>
            <a href="#"><i class="fas fa-image"></i> Galería</a>
            <a href="#"><i class="fas fa-envelope"></i> Contacto</a>
        </nav>

        <div class="usuario">

            <div class="puntos">
                ⭐ 1200
            </div>

            <img src="~/ima_actividades/avatar.png" alt="Avatar">

            <div>
                <strong>Sofía</strong>
                <p>Estudiante</p>
            </div>

        </div>

    </header>

    <!-- CONTENEDOR -->
    <div class="contenedor">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-header">
                <i class="fas fa-clipboard-list"></i>
                <span>Actividades</span>
            </div>

            <ul class="sidebar-menu">

                <li class="active">
                    <a href="#">
                        <i class="fas fa-list"></i>
                        Todas las actividades
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fas fa-star"></i>
                        Mis actividades
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fas fa-book"></i>
                        Por materia
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fas fa-graduation-cap"></i>
                        Por grado
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fas fa-heart"></i>
                        Favoritas
                    </a>
                </li>

                <li>
                    <a href="#">
                        <i class="fas fa-check-square"></i>
                        Completadas
                    </a>
                </li>

            </ul>

        </aside>

        <!-- CONTENIDO -->
        <main class="contenido">

            <!-- BANNER -->
            <section class="banner">

                <img src="~/ima_actividades/banner.png"
                     class="banner-img"
                     alt="Banner">

            </section>

            <!-- BUSCADOR -->
            <div class="filtros">

                <input type="text"
                       placeholder="Buscar actividades..." />

                <select>
                    <option>Todas las materias</option>
                </select>

                <select>
                    <option>Todos los grados</option>
                </select>

                <select>
                    <option>Más recientes</option>
                </select>

            </div>

            <!-- TARJETAS -->
            <section class="cards">

                <div class="card">
                    <img src="~/ima_actividades/01_fracciones_divertidas.png" alt="">
                </div>

                <div class="card">
                    <img src="~/ima_actividades/02_cuentos_magicos.png" alt="">
                </div>


                <div class="card">
                    <img src="~/ima_actividades/05_programa_tu_aventura.png" alt="">
                </div>

                <div class="card">
                    <img src="~/ima_actividades/06_palabras_del_dia.png" alt="">
                </div>

                <div class="card">
                    <img src="~/ima_actividades/07_conozcamos_nuestra_historia.png" alt="">
                </div>

                <div class="card">
                    <img src="~/ima_actividades/08_suma_rapida.png" alt="">
                </div>

            </section>

            <!-- PANEL INFERIOR -->
            <div class="paneles">

                <div class="panel panel-trofeo">
                    <div class="panel-icono">🏆</div>
                    <div class="panel-info">
                        <h3>¡Sigue así, Sofía!</h3>
                        <p>Cada actividad te acerca más a tus metas.</p>
                    </div>
                </div>

                <div class="panel panel-nivel">
                    <div class="panel-info">
                        <h3>Nivel 7</h3>

                        <div class="barra">
                            <div class="progreso"></div>
                        </div>

                        <p>650 / 1000 pts</p>
                    </div>

                    <div class="panel-icono">📦</div>
                </div>

                <div class="panel panel-dia">
                    <div class="panel-icono">🎯</div>
                    <div class="panel-info">
                        <h3>Actividad del día</h3>
                        <p>Completa 3 actividades y gana 30 puntos extra.</p>
                    </div>
                </div>

            </div>
        </main>

    </div>

</body>
</html>